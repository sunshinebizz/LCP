---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SponsoredBanner from "../../../components/SponsoredBanner.astro";
import { getAllStates, getCitiesByState, getProviderCountByCity, getPhysicianCountByCity, getProvidersByState } from "../../../utils/data";
import { getJurisdiction } from "../../../data/jurisdictions";

export function getStaticPaths() {
  return getAllStates().map((state) => ({ params: { state } }));
}

const { state } = Astro.params;
const jurisdiction = state ? getJurisdiction(state) : undefined;
const isCanada = jurisdiction?.country === "Canada";

const stateDisplay = jurisdiction?.name ?? state!
  .split("-")
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join(" ");

const cities = getCitiesByState(state!).map((city) => ({
  name: city,
  count: getProviderCountByCity(state!, city),
  physicianCount: getPhysicianCountByCity(state!, city),
  displayName: city.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
}));

const stateProviders = getProvidersByState(state!);
const totalProvidersInState = stateProviders.length;

const topCities = getCitiesByState(state!).slice(0, 4);
const majorCitiesList = jurisdiction?.majorCities?.length 
  ? jurisdiction.majorCities.slice(0, 4).join(", ")
  : (topCities.map(c => c.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ")).join(", ") || stateDisplay);

const schemaCities = topCities.length > 0 
  ? topCities.map(c => c.split("-").map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "))
  : (jurisdiction?.majorCities ?? [stateDisplay]);

const pageTitle = isCanada
  ? `${stateDisplay} Physician Life Care Planners | Catastrophic Injury Experts`
  : `${stateDisplay} Physician Life Care Planners | PM&R Medical Experts | LCP Directory`;

const pageDescription = isCanada
  ? `Connect with verified physician life care planners serving ${stateDisplay} including ${majorCitiesList}. Objective future care cost valuations for Canadian legal claims.`
  : `Find certified Physician Life Care Planners in ${stateDisplay}. PM&R physician experts for personal injury and insurance claims across ${majorCitiesList}.`;

const stateSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      "@id": `https://mylifecareplanning.com/physician-life-care-planners/${state}/#webpage`,
      "url": `https://mylifecareplanning.com/physician-life-care-planners/${state}/`,
      "name": `${stateDisplay} Physician Life Care Planners`,
      "description": isCanada
        ? `Directory of board-certified physician life care planners serving ${stateDisplay} for catastrophic injury, cross-border tort claims, and private medical cost quantification.`
        : `Directory of board-certified physician life care planners in ${stateDisplay} for personal injury, medical malpractice, and catastrophic claims.`,
      "isPartOf": {"@id": "https://mylifecareplanning.com/#website"},
      "publisher": {"@id": "https://mylifecareplanning.com/#organization"},
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": stateDisplay,
        ...(jurisdiction?.wikipediaUrl ? { "sameAs": jurisdiction.wikipediaUrl } : {}),
        "containsPlace": schemaCities.map(cityName => ({
          "@type": "City",
          "name": cityName
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://mylifecareplanning.com/"},
        {"@type": "ListItem", "position": 2, "name": "Physician Life Care Planners", "item": "https://mylifecareplanning.com/physician-life-care-planners/"},
        {"@type": "ListItem", "position": 3, "name": stateDisplay, "item": `https://mylifecareplanning.com/physician-life-care-planners/${state}/`}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": isCanada ? [
        {
          "@type": "Question",
          "name": `How do Physician Life Care Planners assist in ${stateDisplay} litigation?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `In ${stateDisplay}, Physician Life Care Planners evaluate catastrophic medical records, quantify private healthcare costs not covered by provincial health plans, and provide expert witness reports complying with the Supreme Court of Canada Mohan threshold and provincial court rules.`
          }
        },
        {
          "@type": "Question",
          "name": `What evidentiary standard governs life care plans in ${stateDisplay}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${stateDisplay} courts evaluate expert witness medical opinions under the Canadian Mohan standard (${jurisdiction?.standardRuleRef || "Provincial Rules of Court"}), demanding impartial, clinically substantiated projections of lifetime care needs outside public health coverage.`
          }
        }
      ] : [
        {
          "@type": "Question",
          "name": `How do Physician Life Care Planners assist in ${stateDisplay} litigation?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `In ${stateDisplay}, Physician Life Care Planners evaluate catastrophic medical records, formulate future medical cost projections, and provide expert witness testimony complying with ${jurisdiction?.evidentiaryStandard || "court evidentiary standards"}.`
          }
        },
        {
          "@type": "Question",
          "name": `What legal evidentiary standard applies to life care plans in ${stateDisplay}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${stateDisplay} courts evaluate expert witness medical opinions under the ${jurisdiction?.evidentiaryStandard || "Daubert standard"} (${jurisdiction?.standardRuleRef || "Rule 702"}), requiring reliable clinical methodology and objective documentation.`
          }
        }
      ]
    }
  ]
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://mylifecareplanning.com/physician-life-care-planners/${state}/`}
  schema={stateSchema}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: "Physician Life Care Planners", href: "/physician-life-care-planners" },
          { label: stateDisplay, href: `/physician-life-care-planners/${state}` },
        ]}
      />

      <!-- Standardized State Page Header -->
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        {stateDisplay} Physician Life Care Planners
      </h1>

      <!-- AEO Answer Capsule (Clean, compact subtitle) -->
      <div class="aeo-answer-capsule text-sm sm:text-base text-gray-600 max-w-3xl mb-3 leading-relaxed">
        <p>
          Board-certified physician life care plans and expert witness testimony for catastrophic injury litigation across <strong>{stateDisplay}</strong>{isCanada ? " and Canadian jurisdictions." : " and statewide jurisdictions."}
        </p>
      </div>

      <!-- Compact Legal Evidentiary Standard Badge -->
      {jurisdiction?.evidentiaryStandard && (
        <div class="inline-flex items-center gap-2 text-xs text-gray-600 bg-gray-100 border border-gray-200 px-3 py-1 rounded-full mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-600"></span>
          <span><strong>Court Evidentiary Standard:</strong> {jurisdiction.evidentiaryStandard} ({jurisdiction.standardRuleRef})</span>
        </div>
      )}

      <!-- Canadian Healthcare & Evidentiary Standard Context (Collapsible Accordion Drawer - Option 2) -->
      {isCanada && (
        <details class="group bg-white border border-gray-200 rounded-xl mb-6 shadow-sm overflow-hidden transition-all">
          <summary class="flex items-center justify-between p-4 cursor-pointer select-none hover:bg-gray-50 transition-colors list-none">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-brand-50 text-brand-700 flex items-center justify-center text-xs font-bold">ℹ</span>
              <span class="text-sm font-semibold text-gray-900">
                Canadian Healthcare & Evidentiary Guidelines ({stateDisplay})
              </span>
              <span class="hidden sm:inline text-xs text-gray-500">
                — Mohan standard & private care cost scope
              </span>
            </div>
            <span class="text-xs font-medium text-brand-700 flex items-center gap-1 group-open:rotate-180 transition-transform duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>

          <div class="p-5 sm:p-6 border-t border-gray-100 bg-gray-50/50 space-y-5 text-sm">
            <div>
              <h2 class="text-base font-bold text-gray-900 mb-2">
                Physician Life Care Planning in {stateDisplay}
              </h2>
              <p class="text-gray-700 leading-relaxed text-xs sm:text-sm">
                In {stateDisplay} civil proceedings and catastrophic personal injury litigation, expert evidence must satisfy the admissibility threshold established under <em>R. v. Mohan</em> and {jurisdiction?.standardRuleRef || "provincial civil court rules"}. Board-certified Physician Life Care Planners deliver independent, medically grounded future care assessments to assist {stateDisplay} courts in evaluating lifetime rehabilitation trajectories.
              </p>
            </div>

            <div class="border-t border-gray-200 pt-4">
              <h2 class="text-base font-bold text-gray-900 mb-2">
                Quantifying Future Medical Costs Outside Public Health Coverage
              </h2>
              <p class="text-gray-700 leading-relaxed text-xs sm:text-sm mb-3">
                While provincial healthcare systems fund foundational acute care, catastrophic injuries impose massive lifetime costs that fall entirely outside public provincial coverage. A Canadian life care plan quantifies essential out-of-pocket medical and supportive services across {majorCitiesList} and surrounding regional districts:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs text-gray-700">
                <div class="flex items-start gap-2 bg-white p-2.5 rounded-lg border border-gray-200">
                  <span class="text-brand-600 font-bold">✓</span>
                  <span><strong>Private Attendant Care:</strong> 24/7 personal support worker (PSW/HCA) hours and private duty nursing exceeding public caps.</span>
                </div>
                <div class="flex items-start gap-2 bg-white p-2.5 rounded-lg border border-gray-200">
                  <span class="text-brand-600 font-bold">✓</span>
                  <span><strong>Barrier-Free Housing:</strong> Ceiling track lifts, ramps, accessible roll-in bathrooms, and home environmental controls.</span>
                </div>
                <div class="flex items-start gap-2 bg-white p-2.5 rounded-lg border border-gray-200">
                  <span class="text-brand-600 font-bold">✓</span>
                  <span><strong>Mobility & Accessible Transit:</strong> Power wheelchairs, custom seating, standing frames, and modified accessible vans.</span>
                </div>
                <div class="flex items-start gap-2 bg-white p-2.5 rounded-lg border border-gray-200">
                  <span class="text-brand-600 font-bold">✓</span>
                  <span><strong>Specialized Therapies:</strong> Private neuro-occupational therapy, physiotherapy, and non-formulary pharmaceuticals.</span>
                </div>
              </div>
            </div>
          </div>
        </details>
      )}

      <SponsoredBanner />

      <!-- City Hubs Section -->
      {cities.length > 0 ? (
        <div class="mb-10">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">{isCanada ? `Select a City / Region in ${stateDisplay}` : `Select a City in ${stateDisplay}`}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
            {cities.map(({ name, count, physicianCount, displayName }) => (
              <a
                href={`/physician-life-care-planners/${state}/${name}`}
                class="card p-4 hover:border-brand-400 transition-colors group flex items-center justify-between"
              >
                <span class="font-medium text-gray-800 group-hover:text-brand-700 transition-colors">{displayName}</span>
                <span class="text-xs bg-brand-50 text-brand-700 px-2 py-0.5 rounded-full font-medium">
                  {count} LCP{count !== 1 ? "s" : ""}{physicianCount > 0 ? ` (${physicianCount} Physician)` : ""}
                </span>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 sm:p-8 text-center mb-10">
          <div class="w-12 h-12 bg-brand-100 text-brand-700 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-2">{isCanada ? `Provincial & Regional Expert Witness Services in ${stateDisplay}` : `Statewide & Regional Expert Witness Services in ${stateDisplay}`}</h2>
          <p class="text-sm text-gray-600 max-w-2xl mx-auto mb-5 leading-relaxed">
            {isCanada
              ? `Board-certified Physician Life Care Planners provide comprehensive medical record analysis, tele-rehabilitation evaluations, independent medical evaluations (IMEs), and cross-border deposition and trial testimony throughout ${stateDisplay}, including major metropolitan centers.`
              : `Board-certified Physician Life Care Planners provide comprehensive medical record analysis, tele-rehabilitation evaluations, independent medical evaluations (IMEs), and in-person deposition and trial testimony throughout ${stateDisplay}, including major metropolitan centers.`}
          </p>
          <div class="flex flex-wrap justify-center gap-2 mb-6">
            {jurisdiction?.majorCities?.map((cityName) => (
              <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-white border border-gray-200 text-gray-700 shadow-sm">
                {cityName} Metro
              </span>
            ))}
          </div>
          <a
            href={`/contact?state=${encodeURIComponent(stateDisplay)}`}
            class="inline-flex items-center gap-2 bg-brand-700 text-white text-sm font-semibold px-6 py-3 rounded-lg hover:bg-brand-800 transition-colors shadow-sm"
          >
            Request a {stateDisplay} Life Care Plan Consultation
          </a>
        </div>
      )}

      <div class="mt-8 text-center">
        <a href="/physician-life-care-planners" class="inline-flex items-center gap-2 text-brand-700 font-medium hover:text-brand-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to All Locations
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
