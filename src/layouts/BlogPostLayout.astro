---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { SITE_NAME, SITE_URL, formatDate, postUrl, type BlogPost } from "../utils/blog";

interface Props {
  post: BlogPost;
  minutes: number;
}

const { post, minutes } = Astro.props;
const { title, description, date, updated, author, authorTitle, tags, image, draft } = post.data;

const url = postUrl(post.slug);
const imageUrl = image ? `${SITE_URL}${image}` : `${SITE_URL}/og-image.png`;

const publisher = {
  "@type": "Organization",
  name: SITE_NAME,
  logo: { "@type": "ImageObject", url: `${SITE_URL}/LCP-logo-transparent.png` },
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: title,
      description,
      image: imageUrl,
      author: author
        ? { "@type": "Person", name: author, ...(authorTitle && { jobTitle: authorTitle }) }
        : { "@type": "Organization", name: SITE_NAME },
      publisher,
      datePublished: date.toISOString(),
      dateModified: (updated ?? date).toISOString(),
      keywords: tags.join(", "),
      mainEntityOfPage: { "@type": "WebPage", "@id": url },
      speakable: { "@type": "SpeakableSpecification", cssSelector: [".intro-definition"] },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog/` },
        { "@type": "ListItem", position: 3, name: title, item: url },
      ],
    },
  ],
});
---

<BaseLayout title={`${title} — MyLifeCarePlanning.com`} description={description} canonical={url} schema={schema} image={imageUrl}>
  <Header />
  <main class="flex-1">
    <section class="bg-brand-900 text-white">
      <div class="page-container py-12">
        {draft && <p class="mb-3 inline-block rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Draft — not published</p>}
        <h1 class="text-3xl sm:text-4xl font-bold max-w-3xl">{title}</h1>
        <p class="mt-3 text-brand-200 max-w-2xl">{description}</p>
        <p class="text-xs text-gray-400 mt-4">
          {author ? <span>By {author}{authorTitle && `, ${authorTitle}`} · </span> : null}
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <span> · Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
          <span> · {minutes} min read</span>
        </p>
      </div>
    </section>

    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto">
        <Breadcrumb links={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog/" }, { label: title, href: url }]} />

        <div class="prose prose-gray max-w-none prose-h2:text-2xl prose-h2:font-bold prose-h2:text-brand-900 prose-h2:mt-8 prose-h2:mb-4 prose-h3:text-brand-900 prose-a:text-brand-700 hover:prose-a:text-brand-800">
          <slot />
        </div>

        {tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2">
            {tags.map((tag) => <li class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-800">{tag}</li>)}
          </ul>
        )}

        <div class="mt-10 p-6 bg-brand-50 border border-brand-200 rounded-xl text-center">
          <h3 class="text-lg font-semibold text-brand-900 mb-2">Find a Physician Life Care Planner</h3>
          <p class="text-gray-700 mb-4">Browse our directory of board-certified MDs and DOs by state.</p>
          <a href="/physician-life-care-planners" class="btn-primary text-sm">Browse by State</a>
        </div>

        <p class="mt-6 text-sm"><a href="/blog/" class="text-brand-700 hover:text-brand-800">← All articles</a></p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
